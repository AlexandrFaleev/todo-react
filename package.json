{
  "name": "todo-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch db.json5 --port 3001",
    "start": "concurrently \"npm run server\" and \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prod-start": "concurrently \"npm run server\" and \"npm run preview\""
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "json-server": "^1.0.0-beta.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.105.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
